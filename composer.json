{
    "name": "creativspeed/inertia-bundle",
    "description": "Modern Inertia.js integration for Symfony 8 - Build single-page applications with Vue.js/React without the complexity of APIs",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "symfony",
        "symfony8",
        "inertia",
        "inertiajs",
        "vue",
        "react",
        "spa",
        "bundle"
    ],
    "suggest": {
        "symfony/http-client": "Required if you want to use Server-Side Rendering (SSR)"
    },
    "autoload": {
        "psr-4": {
            "Creativspeed\\InertiaBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "CreativSpeed\\InertiaBundle\\Tests\\": "tests/"
    },
    "authors": [
        {
            "name": "Bachir Brahimi",
            "email": "bachir@creativspeed.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    },
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "symfony/framework-bundle": "^7.0|^8.0",
        "symfony/http-kernel": "^7.0|^8.0",
        "symfony/dependency-injection": "^7.0|^8.0",
        "symfony/config": "^7.0|^8.0",
        "symfony/security-bundle": "^7.0|^8.0",
        "symfony/filesystem": "^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/phpunit-bridge": "^7.0|^8.0",
        "symfony/test-pack": "^1.2"
    }
}
